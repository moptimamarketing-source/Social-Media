{
  "name": "tips-membaca",
  "version": "1.0.0",
  "private": true,
  "description": "Minda Optima — Tips Membaca motion graphic (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "align": "python3 -I tools/align.py public/voice.mp3 src/data/captions.ts",
    "sfx": "python3 -I tools/make_sfx.py public/sfx",
    "preview": "remotion render src/index.ts TipsMembaca out/preview.mp4 --scale=0.5 --crf=26",
    "render": "remotion render src/index.ts TipsMembaca out/raw.mp4 --codec=h264 --crf=16 && bash tools/finalize.sh out/raw.mp4 out/TipsMembaca_final.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
